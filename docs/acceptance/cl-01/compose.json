  {
    "combination": "local",
    "services": {
      "api": {
        "image": "unspun-server:dev",
        "command": null
      },
      "db": {
        "image": "pgvector/pgvector:pg17",
        "command": null
      },
      "r1-worker": {
        "image": "unspun-server:dev",
        "command": [
          "python",
          "-m",
          "unspun.pipeline.r1_worker"
        ],
        "scale": 0,
        "stop_grace_period": "35s"
      },
      "rsshub": {
        "image": "diygod/rsshub:2026-10-09",
        "command": null
      },
      "web": {
        "image": "unspun-web:dev",
        "command": null
      }
    },
    "published_ports": [
      {
        "service": "api",
        "port": {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 8000,
          "published": "8000",
          "protocol": "tcp"
        }
      },
      {
        "service": "db",
        "port": {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 5432,
          "published": "5432",
          "protocol": "tcp"
        }
      },
      {
        "service": "rsshub",
        "port": {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 1200,
          "published": "1200",
          "protocol": "tcp"
        }
      },
      {
        "service": "web",
        "port": {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 80,
          "published": "8080",
          "protocol": "tcp"
        }
      }
    ],
    "r1_enabled": "false"
  },
  {
    "combination": "production",
    "services": {
      "api": {
        "image": "unspun-server:dev",
        "command": null,
        "restart": "unless-stopped"
      },
      "db": {
        "image": "pgvector/pgvector:pg17",
        "command": null,
        "restart": "unless-stopped"
      },
      "db-backup": {
        "image": "pgvector/pgvector:pg17",
        "command": [
          "while true; do\n  pg_dump -h db -U unspun -d unspun -Fc \\\n    -f \"/backups/unspun-$$(date +%F).dump\" \\\n    && find /backups -name '*.dump' -mtime +14 -delete \\\n    && echo \"backup done $$(date -Is)\"\n  sleep 86400\ndone\n"
        ],
        "restart": "unless-stopped"
      },
      "r1-worker": {
        "image": "unspun-server:dev",
        "command": [
          "python",
          "-m",
          "unspun.pipeline.r1_worker"
        ],
        "scale": 1,
        "restart": "unless-stopped",
        "stop_grace_period": "35s",
        "mem_limit": "536870912",
        "memswap_limit": "536870912"
      },
      "rsshub": {
        "image": "diygod/rsshub:2026-10-09",
        "command": null,
        "restart": "unless-stopped",
        "mem_limit": "536870912",
        "memswap_limit": "536870912"
      },
      "web": {
        "image": "unspun-web:dev",
        "command": null,
        "restart": "unless-stopped"
      }
    },
    "published_ports": [
      {
        "service": "web",
        "port": {
          "mode": "ingress",
          "host_ip": "127.0.0.1",
          "target": 80,
          "published": "8080",
          "protocol": "tcp"
        }
      }
    ],
    "r1_enabled": "true"
  }
]

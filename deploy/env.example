# Copy to ~/unspun/.env on the VPS and fill in real values. This file itself
# contains no secrets.
POSTGRES_PASSWORD=change-me

# Used by the controlled r1-worker for explicitly enabled paid stages.
# Production deployment initializes the existing budget and runs preflight
# before starting consumers. API and local defaults do not enable paid work.
OPENROUTER_API_KEY=

# M3-A admin API verifies the Access application JWT. Fill from the website
# Access application; leave unset only for local development outside Docker.
ACCESS_TEAM_DOMAIN=
ACCESS_AUDIENCE=

# R2-11 production defaults enable existing qualified content reading only.
# Base/local defaults are false. Topic processing/publication/preferences stay off.
# Set either value to false explicitly to override the production default:
# home=false restores / to events; hybrid=false also closes the mixed API.
# R2_HYBRID_ENABLED=false
# R2_DISCOVER_HOME_ENABLED=false

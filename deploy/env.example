# Copy to ~/unspun/.env on the VPS and fill in real values. This file itself
# contains no secrets.
POSTGRES_PASSWORD=change-me

# Used from M1 onward. One OpenRouter key covers both chat models and
# embeddings; until it is set, the worker fetches and stores articles but
# skips the summarize/embed/cluster/score stages with a warning.
OPENROUTER_API_KEY=
